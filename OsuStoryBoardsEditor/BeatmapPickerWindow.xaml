<Window x:Class="OsuStoryBoardsEditor.BeatmapPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elegir beatmap con storyboard"
        Width="420" Height="640"
        Background="#1A1A22"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtHeader" Grid.Row="0" Text="Selecciona un beatmap con storyboard (doble click para importar)"
                   Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <TextBox x:Name="TxtSearch"
                     Background="#26262F" Foreground="White" BorderThickness="1"
                     BorderBrush="#3A3A45" Padding="8,6" FontSize="13"
                     TextChanged="TxtSearch_TextChanged"/>
            <TextBlock Text="Buscar por título, artista o creador..."
                       Foreground="#777782" FontSize="13"
                       Margin="10,7,0,0" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <ListBox x:Name="LstBeatmaps" Grid.Row="2"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionMode="Single"
                 MouseDoubleClick="LstBeatmaps_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="6" Margin="0,0,0,8" Height="90">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding BackgroundPath}" Stretch="UniformToFill"/>
                        </Border.Background>
                        <Grid>
                            <Border Background="#66000000" CornerRadius="6"/>
                            <StackPanel VerticalAlignment="Center" Margin="14,0">
                                <TextBlock Text="{Binding Title}" Foreground="White"
                                           FontWeight="Bold" FontSize="15" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Artist}" Foreground="#CCCCCC" FontSize="12"/>
                                <TextBlock FontStyle="Italic" Foreground="#AAAAAA" FontSize="11" Margin="0,4,0,0">
                                    <Run Text="Mapped by "/><Run Text="{Binding Creator}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="BorderBrush" Value="#E879F9"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </Grid>
</Window>