<Window x:Class="OsuStoryBoardsEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OsuStoryBoardsEditor.Controls"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="osu! Storyboard Editor — Alpha"
        Height="720" Width="1200"
        MinHeight="600" MinWidth="900"
        Background="#111114"
        WindowStyle="SingleBorderWindow"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop">

    <Window.Resources>
        <SolidColorBrush x:Key="BgDeep"      Color="#0D0D10"/>
        <SolidColorBrush x:Key="BgBase"      Color="#111114"/>
        <SolidColorBrush x:Key="BgPanel"     Color="#0F0F12"/>
        <SolidColorBrush x:Key="BgHover"     Color="#1A1A20"/>
        <SolidColorBrush x:Key="BgActive"    Color="#1E1428"/>
        <SolidColorBrush x:Key="Border"      Color="#222228"/>
        <SolidColorBrush x:Key="AccentDim"   Color="#3D2050"/>
        <SolidColorBrush x:Key="Accent"      Color="#E879F9"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#CCCCDD"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#666670"/>
        <SolidColorBrush x:Key="TextFaint"   Color="#333340"/>

        <Style x:Key="PropName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PropValue" TargetType="TextBlock">
            <Setter Property="Foreground"    Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize"      Value="10"/>
            <Setter Property="FontFamily"    Value="Consolas"/>
            <Setter Property="Background"    Value="{StaticResource BgHover}"/>
            <Setter Property="Padding"       Value="6,2"/>
            <Setter Property="MinWidth"      Value="56"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="26"/>
            <Setter Property="Height"          Value="26"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgActive}"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="{StaticResource Border}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*" MinHeight="250"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="160" MinHeight="100"/>
        </Grid.RowDefinitions>

        <!-- ROW 0 — Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource BgDeep}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,0.5">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,16,0">
                    <Ellipse Width="10" Height="10" Fill="#FF5F57" Margin="0,0,5,0"/>
                    <Ellipse Width="10" Height="10" Fill="#FEBC2E" Margin="0,0,5,0"/>
                    <Ellipse Width="10" Height="10" Fill="#28C840"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="osu! storyboard editor"
                           Foreground="#444450" FontSize="11"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource BgActive}"
                            BorderBrush="{StaticResource AccentDim}" BorderThickness="0.5"
                            CornerRadius="10" Padding="8,2" Margin="0,0,12,0">
                        <TextBlock Text="ALPHA" Foreground="{StaticResource Accent}"
                                   FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock x:Name="TxtProjectName" Text="beatmap: untitled.osb"
                               Foreground="{StaticResource TextFaint}"
                               FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1 — Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource BgDeep}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,0.5">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolBtn}" Content="↖" ToolTip="Seleccionar"
                            Foreground="{StaticResource Accent}" Background="{StaticResource BgActive}"/>
                    <Button Style="{StaticResource ToolBtn}" Content="✥" ToolTip="Mover"/>
                    <Button Style="{StaticResource ToolBtn}" Content="↺" ToolTip="Rotar"/>
                    <Button Style="{StaticResource ToolBtn}" Content="⤢" ToolTip="Escalar"/>
                    <Rectangle Width="0.5" Height="16" Fill="{StaticResource Border}" Margin="4,0"/>
                    <Button Style="{StaticResource ToolBtn}" Content="◆" ToolTip="Añadir Keyframe"
        Foreground="{StaticResource Accent}"
        Click="BtnAddKeyframe_Click"/>
                    <Button Style="{StaticResource ToolBtn}" Content="+" ToolTip="Añadir Sprite"
                            Click="BtnAddSprite_Click"/>
                    <Rectangle Width="0.5" Height="16" Fill="{StaticResource Border}" Margin="4,0"/>
                    <Button Style="{StaticResource ToolBtn}" Content="⊞" ToolTip="Mostrar cuadrícula"/>

                    <Rectangle Width="0.5" Height="16" Fill="{StaticResource Border}" Margin="4,0"/>
                    <Button Style="{StaticResource ToolBtn}" Content="⬆" ToolTip="Exportar .osb"
        Click="BtnExport_Click" Foreground="{StaticResource Accent}"/>

                    <Rectangle Width="0.5" Height="16" Fill="{StaticResource Border}" Margin="4,0"/>
                    <Button Style="{StaticResource ToolBtn}" Content="💾" ToolTip="Guardar proyecto"
    Click="BtnSave_Click"/>
                    <Button Style="{StaticResource ToolBtn}" Content="📂" ToolTip="Cargar proyecto"
    Click="BtnLoad_Click"/>
                    <Button Style="{StaticResource ToolBtn}" Content="📥" ToolTip="Importar .osb"
    Click="BtnImportOsb_Click" Foreground="{StaticResource Accent}"/>
                    <Button Style="{StaticResource ToolBtn}" Content="🆕" ToolTip="Nuevo SB desde mapa sin storyboard"
    Click="BtnNewSbFromMap_Click" Foreground="{StaticResource Accent}"/>
                    <Button Style="{StaticResource ToolBtn}" Content="⬆" ToolTip="Exportar .osb"
        Click="BtnExport_Click" Foreground="{StaticResource Accent}"/>

                </StackPanel>

                <!-- Playback -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCurrentTime" Text="00:00.000"
                               Foreground="{StaticResource Accent}" FontFamily="Consolas"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="BtnRewind"    Click="BtnRewind_Click"
                            Style="{StaticResource ToolBtn}" Content="⏮" ToolTip="Al inicio"/>
                    <Button x:Name="BtnPrevFrame" Click="BtnPrevFrame_Click"
                            Style="{StaticResource ToolBtn}" Content="⏪" ToolTip="Frame anterior"/>
                    <Button x:Name="BtnPlay"      Click="BtnPlay_Click"
                            Style="{StaticResource ToolBtn}" Content="▶" ToolTip="Reproducir"
                            Foreground="{StaticResource Accent}"/>
                    <Button x:Name="BtnNextFrame" Click="BtnNextFrame_Click"
                            Style="{StaticResource ToolBtn}" Content="⏩" ToolTip="Frame siguiente"/>
                    <Button x:Name="BtnEnd"       Click="BtnEnd_Click"
                            Style="{StaticResource ToolBtn}" Content="⏭" ToolTip="Al final"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="100%" Foreground="{StaticResource TextFaint}"
                               FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Button Style="{StaticResource ToolBtn}" Content="+" ToolTip="Acercar"/>
                    <Button Style="{StaticResource ToolBtn}" Content="−" ToolTip="Alejar"/>
                    <Rectangle Width="0.5" Height="16" Fill="{StaticResource Border}" Margin="4,0"/>

                    <Rectangle Width="0.5" Height="16" Fill="{StaticResource Border}" Margin="4,0"/>
                    <TextBlock Text="FPS:" Foreground="{StaticResource TextMuted}"
           FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="CmbFps"
          Width="52" Height="20"
          FontSize="10" FontFamily="Consolas"
          SelectedIndex="0"
          SelectionChanged="CmbFps_SelectionChanged">
                        <ComboBoxItem Content="30 fps"/>
                        <ComboBoxItem Content="60 fps"/>
                    </ComboBox>

                    <Rectangle Width="0.5" Height="16" Fill="{StaticResource Border}" Margin="4,0"/>
                    <TextBlock Text="Snap:" Foreground="{StaticResource TextMuted}"
           FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="CmbBeatDivisor"
          Width="52" Height="20"
          FontSize="10" FontFamily="Consolas"
          SelectedIndex="3"
          SelectionChanged="CmbBeatDivisor_SelectionChanged">
                        <ComboBoxItem Content="1/1"/>
                        <ComboBoxItem Content="1/2"/>
                        <ComboBoxItem Content="1/3"/>
                        <ComboBoxItem Content="1/4"/>
                        <ComboBoxItem Content="1/5"/>
                    </ComboBox>

                    <Button Style="{StaticResource ToolBtn}" Content="⚙" ToolTip="Configuración"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 2 — Main Area -->
        <Grid Grid.Row="2" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="170" MinWidth="140"/>
            </Grid.ColumnDefinitions>

            <!-- Layers Panel (UserControl) -->
            <controls:LayerPanelControl x:Name="LayerPanel"
                                        Grid.Column="0"
                                        BorderBrush="{StaticResource Border}"
                                        BorderThickness="0,0,0.5,0"/>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"/>

            <!-- Canvas -->
            <Border Grid.Column="2" Background="{StaticResource BgBase}" ClipToBounds="True">
                <Grid ClipToBounds="True">
                    <Grid.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#161618">
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,16,16"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing Brush="#111114">
                                        <GeometryDrawing.Geometry>
                                            <GeometryGroup>
                                                <RectangleGeometry Rect="0,0,8,8"/>
                                                <RectangleGeometry Rect="8,8,8,8"/>
                                            </GeometryGroup>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Grid.Background>
                    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
         Width="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType=Grid}}"
         Height="{Binding ActualHeight, RelativeSource={RelativeSource FindAncestor, AncestorType=Grid}}">
                        <Grid Width="854" Height="480">
                            <Rectangle Fill="#000000"/>
                            <skia:SKElement x:Name="OsuCanvas" Width="854" Height="480"
                PaintSurface="OsuCanvas_PaintSurface"
                MouseLeftButtonDown="Canvas_MouseDown"
                MouseMove="Canvas_MouseMove"
                MouseLeftButtonUp="Canvas_MouseUp"
                MouseRightButtonDown="Canvas_MouseRightButtonDown"/>
                            <TextBlock Text="854 × 480 (storyboard)" Foreground="#1E1E28"
                           FontSize="10" HorizontalAlignment="Right"
                           VerticalAlignment="Bottom" Margin="0,0,6,4"/>
                        </Grid>
                    </Viewbox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"/>

            <!-- Properties Panel -->
            <Border Grid.Column="4" Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0.5,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,0.5">
                            <TextBlock Text="PROPIEDADES"
                                       Foreground="{StaticResource TextFaint}"
                                       FontSize="9" FontWeight="SemiBold"
                                       FontFamily="Segoe UI" Margin="10,8"/>
                        </Border>

                        <!-- Transformación -->
                        <StackPanel Margin="10,8">
                            <TextBlock Text="Transformación" Foreground="{StaticResource TextFaint}"
               FontSize="9" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="X" Style="{StaticResource PropName}"/>
                                <TextBox x:Name="PropX" Grid.Column="1" Text="320"
                 Foreground="{StaticResource Accent}" FontFamily="Consolas" FontSize="10"
                 Background="{StaticResource BgActive}" BorderThickness="0"
                 Padding="6,2" TextAlignment="Right"
                 KeyDown="PropX_KeyDown" LostFocus="PropX_LostFocus"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Y" Style="{StaticResource PropName}"/>
                                <TextBox x:Name="PropY" Grid.Column="1" Text="240"
                 Foreground="{StaticResource Accent}" FontFamily="Consolas" FontSize="10"
                 Background="{StaticResource BgActive}" BorderThickness="0"
                 Padding="6,2" TextAlignment="Right"
                 KeyDown="PropY_KeyDown" LostFocus="PropY_LostFocus"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Escala" Style="{StaticResource PropName}"/>
                                <TextBox x:Name="PropScale" Grid.Column="1" Text="1.00"
                 Foreground="{StaticResource TextPrimary}" FontFamily="Consolas" FontSize="10"
                 Background="{StaticResource BgHover}" BorderThickness="0"
                 Padding="6,2" TextAlignment="Right"
                 KeyDown="PropScale_KeyDown" LostFocus="PropScale_LostFocus"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Rot." Style="{StaticResource PropName}"/>
                                <TextBox x:Name="PropRot" Grid.Column="1" Text="0.00°"
                 Foreground="{StaticResource TextPrimary}" FontFamily="Consolas" FontSize="10"
                 Background="{StaticResource BgHover}" BorderThickness="0"
                 Padding="6,2" TextAlignment="Right"
                 KeyDown="PropRot_KeyDown" LostFocus="PropRot_LostFocus"/>
                            </Grid>
                        </StackPanel>

                        <Rectangle Height="0.5" Fill="{StaticResource Border}" Margin="10,0"/>

                        <!-- Apariencia -->
                        <StackPanel Margin="10,8">
                            <TextBlock Text="Apariencia" Foreground="{StaticResource TextFaint}"
               FontSize="9" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Opacidad" Style="{StaticResource PropName}"/>
                                <TextBox x:Name="PropOpacity" Grid.Column="1" Text="1.00"
                 Foreground="{StaticResource TextPrimary}" FontFamily="Consolas" FontSize="10"
                 Background="{StaticResource BgHover}" BorderThickness="0"
                 Padding="6,2" TextAlignment="Right"
                 KeyDown="PropOpacity_KeyDown" LostFocus="PropOpacity_LostFocus"/>
                            </Grid>
                        </StackPanel>

                        <!-- Animación -->
                        <StackPanel Margin="10,8">
                            <TextBlock Text="Animación" Foreground="{StaticResource TextFaint}"
                                       FontSize="9" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Inicio (ms)" Style="{StaticResource PropName}"/>
                                <TextBlock x:Name="PropStart" Grid.Column="1" Text="0"
                                           Foreground="{StaticResource Accent}" FontFamily="Consolas"
                                           FontSize="10" Background="{StaticResource BgActive}"
                                           Padding="6,2" TextAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Fin (ms)" Style="{StaticResource PropName}"/>
                                <TextBlock x:Name="PropEnd" Grid.Column="1" Text="5000"
                                           Foreground="{StaticResource Accent}" FontFamily="Consolas"
                                           FontSize="10" Background="{StaticResource BgActive}"
                                           Padding="6,2" TextAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ROW 3 — Splitter -->
        <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch"/>

        <!-- ROW 4 — Timeline (UserControl) -->
        <controls:TimeLineControl x:Name="Timeline" Grid.Row="4"/>

    </Grid>
</Window>