<Window x:Class="OsuStoryBoardsEditor.ShakeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shake" Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="14">

        <TextBlock Text="Modo" FontWeight="SemiBold"/>
        <ComboBox x:Name="CmbMode" Margin="0,4,0,10" SelectionChanged="CmbMode_SelectionChanged">
            <ComboBoxItem Content="Suave (ondulante, siempre en movimiento)"/>
            <ComboBoxItem Content="Brusco (golpes secos)"/>
        </ComboBox>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Desde (ms)"/>
                <TextBox x:Name="TxtFrom" Margin="0,2,0,0" TextChanged="Field_Changed"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Hasta (ms)"/>
                <TextBox x:Name="TxtTo" Margin="0,2,0,0" TextChanged="Field_Changed"/>
            </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Amplitud X (px)"/>
                <TextBox x:Name="TxtAmpX" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Amplitud Y (px)"/>
                <TextBox x:Name="TxtAmpY" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Frecuencia (sacudidas por segundo)"/>
        <TextBox x:Name="TxtFreq" Margin="0,2,0,8" TextChanged="Field_Changed"/>

        <CheckBox x:Name="ChkRot" Content="Temblor de rotación" Margin="0,0,0,4"
                  Checked="Field_Changed" Unchecked="Field_Changed"/>
        <TextBlock Text="Rotación máxima (grados)"/>
        <TextBox x:Name="TxtRotDeg" Margin="0,2,0,8"
                 IsEnabled="{Binding IsChecked, ElementName=ChkRot}"/>

        <TextBlock Text="Intensidad al final (%)  (100 = constante, 0 = se apaga)"/>
        <TextBox x:Name="TxtEnd" Margin="0,2,0,8"/>

        <TextBlock Text="Semilla (misma semilla = mismo temblor)"/>
        <Grid Margin="0,2,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="34"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtSeed"/>
            <Button Grid.Column="2" Content="🎲" ToolTip="Otra semilla al azar" Click="BtnSeed_Click"/>
        </Grid>

        <TextBlock x:Name="TxtEstimate" Foreground="Gray" Margin="0,2,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Aceptar" Width="80" Margin="0,0,8,0" IsDefault="True" Click="BtnAccept_Click"/>
            <Button Content="Cancelar" Width="80" IsCancel="True" Click="BtnCancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
