<Window x:Class="OsuStoryBoardsEditor.TextSpriteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Añadir texto" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="14">

        <TextBlock Text="Texto" FontWeight="SemiBold"/>
        <TextBox x:Name="TxtText" Text="Texto de Ejemplo" Margin="0,4,0,10" TextChanged="Input_Changed"/>

        <TextBlock Text="Fuente" FontWeight="SemiBold"/>
        <ComboBox x:Name="CmbFont" Margin="0,4,0,10" SelectionChanged="Input_Changed">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="15"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Tamaño (px)"/>
                <TextBox x:Name="TxtSize" Text="48" Margin="0,2,0,0" TextChanged="Input_Changed"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Color (#RRGGBB)"/>
                <TextBox x:Name="TxtColor" Text="#FFFFFF" Margin="0,2,0,0" TextChanged="Input_Changed"/>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <CheckBox x:Name="ChkBold" Content="Negrita" Margin="0,0,14,0" Click="Input_Changed"/>
            <CheckBox x:Name="ChkItalic" Content="Cursiva" Click="Input_Changed"/>
        </StackPanel>

        <CheckBox x:Name="ChkPerLetter" Margin="0,0,0,10"
                  Content="Una letra por sprite (para animar letra por letra)"/>

        <TextBlock Text="Vista previa" FontWeight="SemiBold"/>
        <Border Background="#111" Height="90" Margin="0,4,0,0" ClipToBounds="True">
            <TextBlock x:Name="PreviewText" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Aceptar" Width="80" Margin="0,0,8,0" IsDefault="True" Click="BtnAccept_Click"/>
            <Button Content="Cancelar" Width="80" IsCancel="True" Click="BtnCancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>