<UserControl x:Class="OsuStoryBoardsEditor.Controls.TimeLineControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:OsuStoryBoardsEditor.Models">

    <UserControl.Resources>
        <SolidColorBrush x:Key="BgDeep"      Color="#0D0D10"/>
        <SolidColorBrush x:Key="BgActive"    Color="#1E1428"/>
        <SolidColorBrush x:Key="Border"      Color="#222228"/>
        <SolidColorBrush x:Key="Accent"      Color="#E879F9"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#666670"/>
        <SolidColorBrush x:Key="TextFaint"   Color="#333340"/>
    </UserControl.Resources>

    <Border Background="{StaticResource BgDeep}"
            BorderBrush="{StaticResource Border}"
            BorderThickness="0,0.5,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <!-- Toolbar -->
                <RowDefinition Height="*"/>
                <!-- Tracks -->
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0,0,0,0.5">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="LÍNEA DE TIEMPO"
               Foreground="{StaticResource TextFaint}"
               FontSize="9" FontWeight="SemiBold"
               VerticalAlignment="Center" Margin="4,0"/>
                        <TextBlock Text="zoom:"
               Foreground="{StaticResource TextFaint}"
               FontSize="9" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <Slider x:Name="ZoomSlider"
            Minimum="1" Maximum="60" Value="1"
            Width="80" VerticalAlignment="Center"
            ValueChanged="ZoomSlider_ValueChanged"/>
                    </StackPanel>

                    <!-- Barra de progreso -->
                    <Border Grid.Column="1"
                            Height="2" Background="#1A1A20"
                            VerticalAlignment="Center" Margin="8,0"
                            CornerRadius="1">
                        <Border x:Name="ProgressBar"
                                Width="0" HorizontalAlignment="Left"
                                Background="{StaticResource Accent}"
                                CornerRadius="1"/>
                    </Border>

                    <TextBlock x:Name="TxtTotalTime"
                               Grid.Column="2"
                               Text="total: 00:00.000"
                               Foreground="{StaticResource TextFaint}"
                               FontSize="9" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Tracks -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <!-- Labels -->
                    <ColumnDefinition Width="*"/>
                    <!-- Barras -->
                </Grid.ColumnDefinitions>

                <!-- Labels de tracks -->
                <Border Grid.Column="0"
        BorderBrush="{StaticResource Border}"
        BorderThickness="0,0,0.5,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Height="14" Background="{StaticResource BgDeep}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,0.5"/>

                        <ScrollViewer x:Name="LabelsScrollViewer"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="LabelsScrollViewer_PreviewMouseWheel">
                            <ItemsControl x:Name="TrackLabels">
                                <ItemsControl.Resources>
                                    <DataTemplate DataType="{x:Type models:OsuSprite}">
                                        <Border Height="36" x:Name="TrackBorder" Background="Transparent" MouseLeftButtonDown="TrackLabel_MouseDown"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0,0,0,0.5"
                    Padding="4,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="▶"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="7"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"
                               Cursor="Hand"
                               MouseLeftButtonDown="ArrowExpand_Click"/>
                                                <TextBlock Text="{Binding Name}"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type models:SpriteFrameGroup}">
                                        <Border Height="36"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0,0,0,0.5"
                    Padding="4,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="▶"
                               Foreground="{StaticResource Accent}"
                               FontSize="7"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"
                               Cursor="Hand"
                               MouseLeftButtonDown="ArrowExpand_Click"/>
                                                <TextBlock FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
    <Run Text="{Binding Name}" Foreground="{StaticResource Accent}"/>
    <Run Text=" (" Foreground="{StaticResource TextMuted}"/>
    <Run Text="{Binding Frames.Count, Mode=OneWay}" Foreground="{StaticResource TextMuted}"/>
    <Run Text=" frames)" Foreground="{StaticResource TextMuted}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.Resources>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Canvas de tracks y playhead -->

                <ScrollViewer x:Name="TracksScrollViewer" Grid.Column="1"
              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden" MinHeight="100"
              ScrollChanged="TracksScrollViewer_ScrollChanged">
                    <Canvas x:Name="TimelineCanvas" MinHeight="200"
        ClipToBounds="True"
        MouseLeftButtonDown="Timeline_MouseDown"
        MouseMove="Timeline_MouseMove"
        MouseLeftButtonUp="Timeline_MouseUp"
        SizeChanged="TimelineCanvas_SizeChanged">

                        <Canvas x:Name="RulerCanvas"
                Canvas.Left="0" Canvas.Top="0"
                Height="14"/>

                        <Canvas x:Name="TracksCanvas"
                Canvas.Left="0" Canvas.Top="14"/>

                        <Polygon x:Name="PlayheadHead"
         Points="0,0 16,0 8,12"
         Fill="#E879F9"
         Canvas.Top="0"
         Canvas.Left="-8"
         Cursor="SizeWE"/>

                        <!-- PlayheadLine -->
                        <Rectangle x:Name="PlayheadLine"
           Width="2"
           Fill="#E879F9"
           Opacity="0.85"
           Canvas.Top="10"
           IsHitTestVisible="False"/>
                    </Canvas>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
