<UserControl x:Class="OsuStoryBoardsEditor.Controls.LayerPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:OsuStoryBoardsEditor.Models">

    <UserControl.Resources>
        <SolidColorBrush x:Key="BgPanel"      Color="#0F0F12"/>
        <SolidColorBrush x:Key="BgHover"      Color="#1A1A20"/>
        <SolidColorBrush x:Key="BgActive"     Color="#1E1428"/>
        <SolidColorBrush x:Key="Border"       Color="#222228"/>
        <SolidColorBrush x:Key="AccentDim"    Color="#3D2050"/>
        <SolidColorBrush x:Key="Accent"       Color="#E879F9"/>
        <SolidColorBrush x:Key="TextPrimary"  Color="#CCCCDD"/>
        <SolidColorBrush x:Key="TextMuted"    Color="#666670"/>
        <SolidColorBrush x:Key="TextFaint"    Color="#333340"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgPanel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Lista de capas -->
            <RowDefinition Height="Auto"/>
            <!-- Botón añadir -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,0.5">
            <TextBlock Text="CAPAS"
                       Foreground="{StaticResource TextFaint}"
                       FontSize="9" FontWeight="SemiBold"
                       FontFamily="Segoe UI"
                       Margin="10,8"/>
        </Border>

        <!-- Lista -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="LayerList" ItemsSource="{Binding Sprites}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:OsuSprite}">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                BorderThickness="0.5"
                                BorderBrush="Transparent"
                                CornerRadius="4"
                                Padding="6,5" Margin="4,1"
                                Cursor="Hand"
                                MouseLeftButtonUp="Layer_Click"
                                Loaded="ItemBorder_Loaded">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Duplicar" Click="CtxDuplicate_Click"/>
                                    <MenuItem Header="Eliminar" Click="CtxDelete_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Efectos">
                                        <MenuItem Header="Loop al ritmo..." Click="CtxBeatLoop_Click"/>
                                    </MenuItem>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icono tipo -->
                                <Border Grid.Column="0"
                                        Background="#251A35" CornerRadius="3"
                                        Width="20" Height="20">
                                    <TextBlock Text="sp"
                                               Foreground="#C084FC"
                                               FontSize="8" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Nombre -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Ojo visibilidad -->
                                <TextBlock Grid.Column="2"
                                           x:Name="EyeIcon"
                                           Text="◉"
                                           Foreground="{StaticResource TextFaint}"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Cursor="Hand"
                                           MouseLeftButtonUp="Visibility_Click"/>
                            </Grid>
                        </Border>

                        <!-- Resaltar si está seleccionado -->
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Visible}" Value="False">
                                <Setter TargetName="EyeIcon" Property="Text" Value="○"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Botón nueva capa -->
        <Border Grid.Row="2"
                Background="Transparent"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0.5"
                CornerRadius="4"
                Margin="6" Padding="0,6"
                Cursor="Hand"
                MouseLeftButtonUp="AddLayer_Click">
            <TextBlock Text="+ nueva capa"
                       Foreground="{StaticResource TextFaint}"
                       FontSize="10"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>